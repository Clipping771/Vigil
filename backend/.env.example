# Copy to backend/.env (never commit it).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: server-side only. Never ship it to the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables LLM weekly summaries and the /api/agent parser.
GEMINI_API_KEY=
# Comma-separated web origins allowed to call this API (e.g. https://vigil.example.com).
ALLOWED_ORIGINS=
