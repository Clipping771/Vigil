# Copy to .env and fill in, then run:
#   flutter run --dart-define-from-file=.env
# Never commit .env. Only public values belong here — the anon key is safe to
# ship because every table is protected by Row Level Security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
